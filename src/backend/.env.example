API_ADDR=127.0.0.1:8080
# Trust only the SvelteKit server's immediate network address for login limits.
# Leave unset for direct API use; never trust all networks.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
DATABASE_URL=postgres://portal67:portal67_dev@127.0.0.1:5432/portal67?sslmode=disable
# Leave blank to queue events in PostgreSQL without running the Redis relay.
REDIS_URL=
# For hosted development use redis://:<url-encoded-password>@redis.ancon-pickerel.ts.net:6379/0.
# Set a separate prefix when multiple environments share Redis.
REDIS_KEY_PREFIX=p67
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://portal67:portal67_dev@127.0.0.1:5432/portal67?sslmode=disable
GOOSE_MIGRATION_DIR=./db/migrations
