API_ADDR=127.0.0.1:8080
# Trust only the SvelteKit server's immediate network address for login limits.
# Leave unset for direct API use; never trust all networks.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
DATABASE_URL=postgres://portal67:portal67_dev@127.0.0.1:5432/portal67?sslmode=disable
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://admin:admin@localhost:5432/admin_db
GOOSE_MIGRATION_DIR=./db/migrations
GOOSE_TABLE=custom.goose_migrations
