# Local development database credentials. Keep the backend DATABASE_URL in sync.
POSTGRES_DB=portal67
POSTGRES_USER=portal67
POSTGRES_PASSWORD=portal67_dev
POSTGRES_PORT=5432

# Prototype v2. Generate both signing values with portalctl keygen.
IDENTITY_SIGNING_KEY=
IDENTITY_PUBLIC_KEYS=
GATEWAY_PORT=8080
REDIS_KEY_PREFIX=p67:v2
# Compose uses its private Redis when this is empty. For the hosted development
# Redis supply redis://:<url-encoded-password>@redis.ancon-pickerel.ts.net:6379/0.
REDIS_URL=
PORTAL67_SEED_DEMO=1
# Set the admin and all five service URLs when using a different database.
# PORTAL67_ADMIN_DATABASE_URL=postgres://portal67:portal67_dev@db:5432/portal67?sslmode=disable
# IDENTITY_DATABASE_URL=postgres://portal67_identity:identity_dev@db:5432/portal67?sslmode=disable
# ACADEMIC_DATABASE_URL=postgres://portal67_academic:academic_dev@db:5432/portal67?sslmode=disable
# AFFAIRS_DATABASE_URL=postgres://portal67_affairs:affairs_dev@db:5432/portal67?sslmode=disable
# REGISTRATION_DATABASE_URL=postgres://portal67_registration:registration_dev@db:5432/portal67?sslmode=disable
# NOTIFICATION_DATABASE_URL=postgres://portal67_notification:notification_dev@db:5432/portal67?sslmode=disable
